# === LLM Provider (mimo via OpenAI-compatible API) ===
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_API_KEY=your_mimo_api_key_here
MIMO_MODEL=mimo-v2.5
MIMO_PRO_MODEL=mimo-v2.5-pro

# === Vector DB ===
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=traffic_knowledge

# === Graph DB ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here

# === Auth ===
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# === Embedding ===
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024

# === Reranker ===
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# === Application ===
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
# Comma-separated list of allowed origins for CORS (use * for development only)
CORS_ORIGINS=*

# === Data Path ===
DATA_DIR=./rag_information
SENSITIVE_WORDS_PATH=./data/sensitive_words/traffic_words.txt
